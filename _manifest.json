{
  "manifest_version": 2,
  "version": "1.4.4",
  "plugin_type": "adapter",
  "name": "微信链路统一托管",
  "description": "为 MaiBot 提供微信消息桥接。使用独立 reader 和配套微信 hook，支持进程守护、会话白名单、发送调度与断线补收。",
  "author": {
    "name": "suodeovo",
    "url": "https://github.com/suodeovo"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/suodeovo/MaiBot-WeChat-Bridge",
    "homepage": "https://github.com/suodeovo/MaiBot-WeChat-Bridge",
    "documentation": "https://github.com/suodeovo/MaiBot-WeChat-Bridge/blob/main/README.md",
    "issues": "https://github.com/suodeovo/MaiBot-WeChat-Bridge/issues"
  },
  "host_application": {
    "min_version": "1.3.16",
    "max_version": "1.4.3"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.22.1"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "websockets",
      "version_spec": ">=12.0"
    },
    {
      "type": "python_package",
      "name": "pydantic",
      "version_spec": ">=2.0"
    }
  ],
  "capabilities": [
    "gateway.route_message",
    "gateway.update_state",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "local.wxsupervisor"
}
